APP_NAME=LegalCheck Ethiopia
APP_ENVIRONMENT=development
# Required for rate limits and optional answer caching.
REDIS_URL=redis://localhost:6379/0
# Bump to invalidate answer-cache keys; TTL 0 disables answer caching only.
LEGAL_QA_CACHE_VERSION=v1
LEGAL_QA_CACHE_TTL_SECONDS=3600
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/legalcheck
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional password reset delivery. Resend credentials stay on the backend.
PASSWORD_RESET_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
MAX_DOCX_UNCOMPRESSED_SIZE_MB=50
PRIVATE_STORAGE_PATH=var/private-documents
# Optional local English Tesseract OCR; requires the `tesseract` executable.
OCR_ENABLED=false
# Optional. Local Sentence Transformers requires an already provisioned model directory.
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_URL=
# Supply credentials only in the ignored .env file or a deployment secret store.
EMBEDDING_API_KEY=
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL_VERSION=v1
# Exact/keyword/vector retrieval strategy and candidate/result cutoffs.
LEGAL_RETRIEVAL_MODE=hybrid
LEGAL_RETRIEVAL_CANDIDATE_K=20
LEGAL_RETRIEVAL_RRF_OFFSET=60
LEGAL_QA_TOP_K=5
# Optional local-only reranker; the model must already exist at this path.
LEGAL_RERANKER_ENABLED=false
LEGAL_RERANKER_MODEL_PATH=
LEGAL_RERANKER_MODEL_VERSION=v1
LLM_PROVIDER=disabled
LLM_API_URL=
# Supply credentials only in the ignored .env file or a deployment secret store.
LLM_API_KEY=
LLM_MODEL_NAME=not-configured
LLM_MODEL_VERSION=v1
LLM_TIMEOUT_SECONDS=90
LEGAL_QA_LLM_PROVIDER=
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10
