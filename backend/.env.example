APP_NAME=LegalCheck Ethiopia
APP_ENVIRONMENT=development
# Required for rate limits and audit jobs; answer caching also uses this Redis.
REDIS_URL=redis://localhost:6379/0
# Bump to invalidate answer-cache keys; TTL 0 disables answer caching only.
LEGAL_QA_CACHE_VERSION=v1
LEGAL_QA_CACHE_TTL_SECONDS=3600
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/legalcheck
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=10
MAX_DOCX_UNCOMPRESSED_SIZE_MB=50
PRIVATE_STORAGE_PATH=var/private-documents
REPORT_UNICODE_FONT_PATH=
# OCR is not implemented; true only reports that no OCR provider is integrated.
OCR_ENABLED=false
# Optional. Local Sentence Transformers requires an already provisioned model directory.
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_URL=
# Supply credentials only in the ignored .env file or a deployment secret store.
EMBEDDING_API_KEY=
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL_VERSION=v1
# Required for generated answers; disabled returns an explicit unavailable error.
LLM_PROVIDER=disabled
LLM_API_URL=
# Supply credentials only in the ignored .env file or a deployment secret store.
LLM_API_KEY=
LLM_MODEL_NAME=not-configured
LLM_MODEL_VERSION=v1
LLM_TIMEOUT_SECONDS=90
AUDIT_JOB_TIMEOUT_SECONDS=1800
AUDIT_STALE_AFTER_SECONDS=2100
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AUDIT_PER_MINUTE=5
MAX_CONTRACT_ANALYSIS_CHARACTERS=500000
